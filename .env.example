# Copy this file to .env and fill in what you need.
# Only PUBLIC_BASE_URL is required before you can place real calls.

# ---------------------------------------------------------------- required
# The publicly reachable origin Twilio will call back to. During local
# development run `ngrok http 8000` and paste the https URL here.
# The background scheduler has no incoming request to infer this from, so it
# MUST be set before a campaign will start.
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- security
# Generate both, then keep them out of version control.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, secret.key is created on first run (fine locally, not for production).
# Losing FERNET_KEY makes every stored Twilio/Groq credential undecryptable.
FERNET_KEY=
SESSION_SECRET=

# Set to 0 ONLY for plain-HTTP local testing; leave unset in production so the
# session cookie is marked Secure.
SANCHARAI_SECURE_COOKIES=1

# Comma-separated emails allowed to view /admin.
PLATFORM_ADMINS=avanixyxx@gmail.com

# ------------------------------------------------------------------- email
# Brevo (https://app.brevo.com -> SMTP & API -> API Keys). Without this,
# verification/reset/invite links are printed to the server log instead.
BREVO_API_KEY=
MAIL_FROM=no-reply@sancharai.in
MAIL_FROM_NAME=SancharAI

# ---------------------------------------------------------------- payments
# Razorpay. Until both are set, plan upgrades are BLOCKED rather than granted
# for free (which is what v2 did).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local development escape hatch: apply plan upgrades with no payment.
# Every grant is logged loudly. Never set this in production.
SANCHARAI_ALLOW_DEMO_UPGRADES=0

# --------------------------------------------------------------- scheduler
# Set to 0 on every process except one. Two schedulers dial every contact twice.
SANCHARAI_SCHEDULER=1
SANCHARAI_SCHEDULER_TICK=15
SANCHARAI_SCHEDULER_BATCH=3

# Skip Twilio webhook signature checks. Useful only when replaying requests by
# hand in local testing - it disables a real security control.
SANCHARAI_SKIP_TWILIO_VALIDATION=0
